<Window x:Class="PowerPointLabs.ShapeToolsLab.Views.BlobDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blob Shape" Height="300" Width="340"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="Point Count:" FontSize="12" Margin="0,0,0,2"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="pointCountSlider" Minimum="5" Maximum="30" Value="10"
                    TickFrequency="1" IsSnapToTickEnabled="True"/>
            <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=pointCountSlider, StringFormat={}{0:F0}}"
                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>

        <TextBlock Text="Base Radius:" FontSize="12" Margin="0,8,0,2"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="radiusSlider" Minimum="30" Maximum="250" Value="100"
                    TickFrequency="5" IsSnapToTickEnabled="True"/>
            <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=radiusSlider, StringFormat={}{0:F0}}"
                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>

        <TextBlock Text="Jitter:" FontSize="12" Margin="0,8,0,2"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="jitterSlider" Minimum="0" Maximum="100" Value="30"
                    TickFrequency="5" IsSnapToTickEnabled="True"/>
            <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=jitterSlider, StringFormat={}{0:F0}}"
                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Seed:" FontSize="12" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Randomize" Width="80" Height="24" Click="Randomize_Click"/>
        </Grid>
        <TextBlock x:Name="seedLabel" Text="Seed: 42" FontSize="11" Foreground="Gray" Margin="0,2,0,0"/>

        <Button Content="Generate" Height="30" Margin="0,12,0,0" Click="Generate_Click"/>
    </StackPanel>
</Window>
