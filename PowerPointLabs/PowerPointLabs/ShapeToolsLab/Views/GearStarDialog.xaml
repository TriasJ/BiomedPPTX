<Window x:Class="PowerPointLabs.ShapeToolsLab.Views.GearStarDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gear / Star" Height="300" Width="340"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="Mode:" FontSize="12" Margin="0,0,0,4"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <RadioButton x:Name="starMode" Content="Star" IsChecked="True" Margin="0,0,16,0"/>
            <RadioButton x:Name="gearMode" Content="Gear"/>
        </StackPanel>

        <TextBlock Text="Points / Teeth:" FontSize="12" Margin="0,0,0,2"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="pointsSlider" Minimum="3" Maximum="32" Value="5"
                    TickFrequency="1" IsSnapToTickEnabled="True"/>
            <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=pointsSlider, StringFormat={}{0:F0}}"
                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>

        <TextBlock Text="Outer Radius:" FontSize="12" Margin="0,8,0,2"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="outerRadiusSlider" Minimum="30" Maximum="250" Value="120"
                    TickFrequency="5" IsSnapToTickEnabled="True"/>
            <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=outerRadiusSlider, StringFormat={}{0:F0}}"
                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>

        <TextBlock Text="Inner Radius:" FontSize="12" Margin="0,8,0,2"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="innerRadiusSlider" Minimum="10" Maximum="200" Value="50"
                    TickFrequency="5" IsSnapToTickEnabled="True"/>
            <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=innerRadiusSlider, StringFormat={}{0:F0}}"
                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>

        <Button Content="Generate" Height="30" Margin="0,12,0,0" Click="Generate_Click"/>
    </StackPanel>
</Window>
