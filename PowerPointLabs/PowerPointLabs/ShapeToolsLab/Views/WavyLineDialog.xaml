<Window x:Class="PowerPointLabs.ShapeToolsLab.Views.WavyLineDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wavy Line" Height="280" Width="340"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="Amplitude:" FontSize="12" Margin="0,0,0,2"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="amplitudeSlider" Minimum="5" Maximum="200" Value="60"
                    TickFrequency="5" IsSnapToTickEnabled="True"/>
            <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=amplitudeSlider, StringFormat={}{0:F0}}"
                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>

        <TextBlock Text="Frequency:" FontSize="12" Margin="0,8,0,2"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="frequencySlider" Minimum="1" Maximum="20" Value="3"
                    TickFrequency="1" IsSnapToTickEnabled="True"/>
            <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=frequencySlider, StringFormat={}{0:F0}}"
                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>

        <TextBlock Text="Width:" FontSize="12" Margin="0,8,0,2"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="widthSlider" Minimum="100" Maximum="800" Value="500"
                    TickFrequency="10" IsSnapToTickEnabled="True"/>
            <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=widthSlider, StringFormat={}{0:F0}}"
                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>

        <TextBlock Text="Smoothness:" FontSize="12" Margin="0,8,0,2"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="pointsSlider" Minimum="20" Maximum="200" Value="80"
                    TickFrequency="10" IsSnapToTickEnabled="True"/>
            <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=pointsSlider, StringFormat={}{0:F0}}"
                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>

        <Button Content="Generate" Height="30" Margin="0,12,0,0" Click="Generate_Click"/>
    </StackPanel>
</Window>
