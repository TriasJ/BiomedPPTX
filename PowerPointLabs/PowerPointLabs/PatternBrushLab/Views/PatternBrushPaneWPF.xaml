<UserControl x:Class="PowerPointLabs.PatternBrushLab.Views.PatternBrushPaneWPF"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="280"
             Loaded="PatternBrushPaneWPF_Loaded">

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Pattern Brush" FontSize="14" FontWeight="SemiBold"
                   Margin="8,8,8,4" Foreground="#333333"/>

        <!-- Search -->
        <Grid Grid.Row="1" Margin="8,0,8,4">
            <TextBox x:Name="searchBox" Height="26" Padding="4" FontSize="11"
                     TextChanged="SearchBox_TextChanged"/>
        </Grid>

        <!-- Axis filter -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="8,0,8,4">
            <RadioButton x:Name="filterAll" Content="All" IsChecked="True" Margin="0,0,8,0"
                         Checked="AxisFilter_Changed" GroupName="AxisFilter" FontSize="11"/>
            <RadioButton x:Name="filterHorizontal" Content="1D Horiz" Margin="0,0,8,0"
                         Checked="AxisFilter_Changed" GroupName="AxisFilter" FontSize="11"/>
            <RadioButton x:Name="filterVertical" Content="1D Vert" Margin="0,0,8,0"
                         Checked="AxisFilter_Changed" GroupName="AxisFilter" FontSize="11"/>
            <RadioButton x:Name="filter2D" Content="2D Grid" Margin="0,0,8,0"
                         Checked="AxisFilter_Changed" GroupName="AxisFilter" FontSize="11"/>
        </StackPanel>

        <!-- Pattern grid -->
        <ListBox x:Name="patternList"
                 Grid.Row="3"
                 Margin="8,0,8,4"
                 SelectionMode="Single"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Background="White"
                 BorderBrush="#DDDDDD"
                 SelectionChanged="PatternList_SelectionChanged">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="78" Margin="3" ToolTip="{Binding Name}">
                        <Border BorderBrush="{Binding BorderColor}" BorderThickness="2" CornerRadius="2">
                            <Image Source="{Binding ThumbnailPath}"
                                   Width="72" Height="72"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <TextBlock Text="{Binding DisplayName}"
                                   TextTrimming="CharacterEllipsis"
                                   TextAlignment="Center"
                                   FontSize="8"
                                   MaxHeight="24"
                                   Foreground="#333333"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Selected pattern info -->
        <StackPanel Grid.Row="4" Margin="8,0,8,4">
            <TextBlock x:Name="selectedPatternText" FontSize="11" FontWeight="SemiBold"
                       Foreground="#333333" Text="No pattern selected"/>
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Overlap:" FontSize="11" VerticalAlignment="Center"
                           Foreground="#666666"/>
                <Slider x:Name="overlapSlider" Grid.Column="1" Minimum="0" Maximum="30" Value="10"
                        Margin="6,0,6,0" VerticalAlignment="Center"
                        ValueChanged="OverlapSlider_ValueChanged"
                        TickFrequency="1" IsSnapToTickEnabled="True"/>
                <TextBlock x:Name="overlapValueText" Grid.Column="2" FontSize="11"
                           VerticalAlignment="Center" Foreground="#666666" Text="10 pt"/>
            </Grid>
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Angle:" FontSize="11" VerticalAlignment="Center"
                           Foreground="#666666"
                           ToolTip="Fixed rotation offset from path tangent (degrees). Use 0 for along-path, -90 or 90 for perpendicular."/>
                <Slider x:Name="angleOffsetSlider" Grid.Column="1" Minimum="-180" Maximum="180" Value="0"
                        Margin="6,0,6,0" VerticalAlignment="Center"
                        ValueChanged="AngleOffsetSlider_ValueChanged"
                        TickFrequency="15" IsSnapToTickEnabled="True"/>
                <TextBlock x:Name="angleOffsetValueText" Grid.Column="2" FontSize="11"
                           VerticalAlignment="Center" Foreground="#666666" Text="0 deg"/>
            </Grid>
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Scatter:" FontSize="11" VerticalAlignment="Center"
                           Foreground="#666666"
                           ToolTip="Random perpendicular offset from path center (points)"/>
                <Slider x:Name="scatterSlider" Grid.Column="1" Minimum="0" Maximum="50" Value="0"
                        Margin="6,0,6,0" VerticalAlignment="Center"
                        ValueChanged="ScatterSlider_ValueChanged"
                        TickFrequency="1" IsSnapToTickEnabled="True"/>
                <TextBlock x:Name="scatterValueText" Grid.Column="2" FontSize="11"
                           VerticalAlignment="Center" Foreground="#666666" Text="0 pt"/>
            </Grid>
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Jitter:" FontSize="11" VerticalAlignment="Center"
                           Foreground="#666666"
                           ToolTip="Random rotation offset (degrees)"/>
                <Slider x:Name="jitterSlider" Grid.Column="1" Minimum="0" Maximum="90" Value="0"
                        Margin="6,0,6,0" VerticalAlignment="Center"
                        ValueChanged="JitterSlider_ValueChanged"
                        TickFrequency="5" IsSnapToTickEnabled="True"/>
                <TextBlock x:Name="jitterValueText" Grid.Column="2" FontSize="11"
                           VerticalAlignment="Center" Foreground="#666666" Text="0 deg"/>
            </Grid>
        </StackPanel>

        <!-- Brush mode toggle -->
        <CheckBox x:Name="autoConvertToggle"
                  Grid.Row="5"
                  Content="Auto-convert new lines"
                  Margin="8,0,8,4"
                  FontSize="11"
                  ToolTip="When enabled, newly drawn lines and freeforms are automatically converted to the selected pattern"
                  Checked="AutoConvert_Changed"
                  Unchecked="AutoConvert_Changed"/>

        <!-- Apply button -->
        <Button x:Name="applyButton"
                Grid.Row="6"
                Content="Apply to Selection"
                Height="30" Margin="8,0,8,8"
                FontSize="12"
                Click="ApplyButton_Click"
                IsEnabled="False"/>
    </Grid>
</UserControl>