<UserControl x:Class="PowerPointLabs.SmartBrowserLab.Views.SmartBrowserPaneWPF"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="833" d:DesignWidth="300"
             Loaded="SmartBrowserPaneWPF_Loaded">

    <UserControl.Resources>
        <Style x:Key="TagToggleStyle" TargetType="ToggleButton">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#4A90D9"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search bar -->
        <Grid Grid.Row="0" Margin="8,8,8,4">
            <TextBox x:Name="searchBox"
                     Height="28"
                     Padding="24,4,4,4"
                     FontSize="12"
                     TextChanged="SearchBox_TextChanged"
                     ToolTip="Search illustrations by name or description"/>
            <TextBlock Text="&#x1F50D;"
                       IsHitTestVisible="False"
                       VerticalAlignment="Center"
                       Margin="6,0,0,0"
                       FontSize="14"
                       Foreground="Gray"/>
            <TextBlock x:Name="searchPlaceholder"
                       Text="Search illustrations..."
                       IsHitTestVisible="False"
                       VerticalAlignment="Center"
                       Margin="28,0,0,0"
                       FontSize="12"
                       Foreground="#999999"
                       Visibility="Visible"/>
        </Grid>

        <!-- Category dropdown + BioArt toggle -->
        <Grid Grid.Row="1" Margin="8,0,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="categoryBox"
                      Grid.Column="0"
                      Height="26"
                      FontSize="11"
                      SelectionChanged="CategoryBox_SelectionChanged"
                      Foreground="Black">
                <ComboBox.Resources>
                    <Style TargetType="TextBlock"/>
                </ComboBox.Resources>
            </ComboBox>
            <CheckBox x:Name="bioArtToggle"
                      Grid.Column="1"
                      Content="BioArt"
                      VerticalAlignment="Center"
                      Margin="6,0,0,0"
                      FontSize="11"
                      ToolTip="Include NCBI BioArt illustrations (online)"
                      Checked="BioArtToggle_Changed"
                      Unchecked="BioArtToggle_Changed"/>
        </Grid>

        <!-- Tag filter chips -->
        <WrapPanel x:Name="tagPanel" Grid.Row="2" Margin="8,0,8,4" Orientation="Horizontal"/>

        <!-- Thumbnail grid -->
        <ListBox x:Name="illustrationList"
                 Grid.Row="3"
                 Margin="8,0,8,4"
                 SelectionMode="Single"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Background="White"
                 BorderBrush="#DDDDDD"
                 BorderThickness="1"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingStackPanel.IsVirtualizing="True"
                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                 MouseDoubleClick="IllustrationList_DoubleClick"
                 SelectionChanged="IllustrationList_SelectionChanged">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="88" Margin="4" ToolTip="{Binding Description}">
                        <Image Source="{Binding ThumbnailPath}"
                               Width="80" Height="80"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="{Binding DisplayName}"
                                   TextTrimming="CharacterEllipsis"
                                   TextAlignment="Center"
                                   FontSize="9"
                                   MaxHeight="28"
                                   Foreground="#333333"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="insertEditableMenuItem" Header="Insert as Editable Shape" Click="InsertEditable_Click"/>
                    <MenuItem x:Name="insertImageMenuItem" Header="Insert as Image" Click="InsertImage_Click"/>
                    <Separator/>
                    <MenuItem x:Name="useAsPathPatternMenuItem" Header="Use as Path Pattern (1D)" Click="UseAsPathPattern_Click"
                              ToolTip="Tile this illustration along shape outlines (lines, circles, stars)"/>
                    <MenuItem x:Name="useAsFillPatternMenuItem" Header="Use as Fill Pattern (2D)" Click="UseAsFillPattern_Click"
                              ToolTip="Fill an area with this illustration in a grid pattern"/>
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListBox>

        <!-- Recolor panel -->
        <StackPanel Grid.Row="4" Margin="8,0,8,4">
            <ToggleButton x:Name="recolorToggle" Content="Recolor" Height="24" FontSize="11"
                          Margin="0,0,0,4" Checked="RecolorToggle_Changed" Unchecked="RecolorToggle_Changed"
                          ToolTip="Adjust hue and saturation of selected grouped shapes on the slide (SMART shapes only, not BioArt images)"/>
            <StackPanel x:Name="recolorPanel" Visibility="Collapsed">
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Hue:" FontSize="11" VerticalAlignment="Center" Foreground="#666666"/>
                    <Slider x:Name="hueSlider" Grid.Column="1" Minimum="-180" Maximum="180" Value="0"
                            Margin="6,0,6,0" VerticalAlignment="Center"
                            ValueChanged="HueSlider_ValueChanged"
                            TickFrequency="15" IsSnapToTickEnabled="True"/>
                    <TextBlock x:Name="hueValueText" Grid.Column="2" FontSize="11"
                               VerticalAlignment="Center" Foreground="#666666" Text="0"/>
                </Grid>
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Sat:" FontSize="11" VerticalAlignment="Center" Foreground="#666666"/>
                    <Slider x:Name="satSlider" Grid.Column="1" Minimum="0" Maximum="200" Value="100"
                            Margin="6,0,6,0" VerticalAlignment="Center"
                            ValueChanged="SatSlider_ValueChanged"
                            TickFrequency="10" IsSnapToTickEnabled="True"/>
                    <TextBlock x:Name="satValueText" Grid.Column="2" FontSize="11"
                               VerticalAlignment="Center" Foreground="#666666" Text="100%"/>
                </Grid>
                <Button x:Name="applyRecolorButton" Content="Apply Recolor" Height="24" FontSize="11"
                        Margin="0,4,0,0" Click="ApplyRecolor_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- Status bar -->
        <Grid Grid.Row="5" Margin="8,0,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="statusText"
                       Grid.Column="0"
                       FontSize="11"
                       Foreground="#666666"
                       VerticalAlignment="Center"
                       Text="Ready"/>
            <Button x:Name="insertButton"
                    Grid.Column="1"
                    Content="Insert"
                    Width="60" Height="26"
                    FontSize="11"
                    Click="InsertButton_Click"
                    IsEnabled="False"/>
        </Grid>
    </Grid>
</UserControl>