<![CDATA[<UserControl x:Class="PowerPointLabs.SmartBrowserLab.Views.SmartBrowserPaneWPF"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="833" d:DesignWidth="300"
             Loaded="SmartBrowserPaneWPF_Loaded">

    <UserControl.Resources>
        <Style x:Key="TagToggleStyle" TargetType="ToggleButton">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#4A90D9"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search bar -->
        <Grid Grid.Row="0" Margin="8,8,8,4">
            <TextBox x:Name="searchBox"
                     Height="28"
                     Padding="24,4,4,4"
                     FontSize="12"
                     TextChanged="SearchBox_TextChanged"
                     ToolTip="Search illustrations by name or description"/>
            <TextBlock Text="&#x1F50D;"
                       IsHitTestVisible="False"
                       VerticalAlignment="Center"
                       Margin="6,0,0,0"
                       FontSize="14"
                       Foreground="Gray"/>
            <TextBlock x:Name="searchPlaceholder"
                       Text="Search illustrations..."
                       IsHitTestVisible="False"
                       VerticalAlignment="Center"
                       Margin="28,0,0,0"
                       FontSize="12"
                       Foreground="#999999"
                       Visibility="Visible"/>
        </Grid>

        <!-- Category dropdown + BioArt toggle -->
        <Grid Grid.Row="1" Margin="8,0,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="categoryBox"
                      Grid.Column="0"
                      Height="26"
                      FontSize="11"
                      SelectionChanged="CategoryBox_SelectionChanged"
                      Foreground="Black">
                <ComboBox.Resources>
                    <Style TargetType="TextBlock"/>
                </ComboBox.Resources>
            </ComboBox>
            <CheckBox x:Name="bioArtToggle"
                      Grid.Column="1"
                      Content="BioArt"
                      VerticalAlignment="Center"
                      Margin="6,0,0,0"
                      FontSize="11"
                      ToolTip="Include NCBI BioArt illustrations (online)"
                      Checked="BioArtToggle_Changed"
                      Unchecked="BioArtToggle_Changed"/>
        </Grid>

        <!-- Tag filter chips -->
        <WrapPanel x:Name="tagPanel" Grid.Row="2" Margin="8,0,8,4" Orientation="Horizontal"/>

        <!-- Thumbnail grid -->
        <ListBox x:Name="illustrationList"
                 Grid.Row="3"
                 Margin="8,0,8,4"
                 SelectionMode="Single"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Background="White"
                 BorderBrush="#DDDDDD"
                 BorderThickness="1"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingStackPanel.IsVirtualizing="True"
                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                 MouseDoubleClick="IllustrationList_DoubleClick">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="88" Margin="4" ToolTip="{Binding Description}">
                        <Image Source="{Binding ThumbnailPath}"
                               Width="80" Height="80"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="{Binding DisplayName}"
                                   TextTrimming="CharacterEllipsis"
                                   TextAlignment="Center"
                                   FontSize="9"
                                   MaxHeight="28"
                                   Foreground="#333333"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="insertEditableMenuItem" Header="Insert as Editable Shape" Click="InsertEditable_Click"/>
                    <MenuItem x:Name="insertImageMenuItem" Header="Insert as Image" Click="InsertImage_Click"/>
                    <Separator/>
                    <MenuItem x:Name="useAsPatternMenuItem" Header="Use as Pattern Brush" Click="UseAsPattern_Click"/>
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListBox>

        <!-- Status bar -->
        <Grid Grid.Row="4" Margin="8,0,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="statusText"
                       Grid.Column="0"
                       FontSize="11"
                       Foreground="#666666"
                       VerticalAlignment="Center"
                       Text="Ready"/>
            <Button x:Name="insertButton"
                    Grid.Column="1"
                    Content="Insert"
                    Width="60" Height="26"
                    FontSize="11"
                    Click="InsertButton_Click"
                    IsEnabled="False"/>
        </Grid>
    </Grid>
</UserControl>
]]>